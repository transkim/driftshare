{
  "name": "driftshare",
  "version": "0.1.0",
  "description": "Send files, photos and messages between your PC and phone over local Wi-Fi.",
  "main": "src/main.js",
  "license": "MIT",
  "scripts": {
    "start": "electron .",
    "hub": "node src/standalone.js",
    "test": "node --test test/*.test.js",
    "package:win": "electron-packager . Driftshare --platform=win32 --arch=x64 --out=dist --overwrite --ignore=^/dist --ignore=^/mobile --ignore=^/test",
    "dist:win": "electron-builder --win nsis --x64"
  },
  "dependencies": {
    "qrcode": "1.5.4"
  },
  "devDependencies": {
    "@electron/packager": "18.3.6",
    "electron": "33.2.1",
    "electron-builder": "26.0.12"
  },
  "author": "Hajj Abdul Hakim",
  "build": {
    "appId": "app.driftshare.desktop",
    "productName": "Driftshare",
    "files": [
      "src/**",
      "ui/**",
      "package.json"
    ],
    "directories": {
      "output": "dist"
    },
    "win": {
      "target": [
        "nsis"
      ],
      "icon": "ui/icon.ico"
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "artifactName": "Driftshare-Setup-${version}.exe"
    }
  }
}
